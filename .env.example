# AI Music Video OS — environment configuration
# Copy to `.env` and adjust. Never commit `.env`.
# Config precedence: defaults < .env < environment variables < constructor overrides.
# Reference: MAD-001 sections 48, 92-94; TDD-001 section 77.

# Environment profile: development | test | mock | production
APP_ENV=development

# Provider cost mode: mock | free | balanced | quality | custom
PROVIDER_MODE=mock

# Logging
LOG_LEVEL=INFO

# Application data directory (defaults to <repo-root>/data)
# APP_DATA_DIR=

# Database (SQLite; defaults to <APP_DATA_DIR>/database/app.db)
# DATABASE_URL=sqlite:///./data/database/app.db

# Temporary directory (defaults to <APP_DATA_DIR>/temp)
# TEMP_DIR=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=production

# API server
API_HOST=127.0.0.1
API_PORT=8000
# AUTO_RELOAD=false

# Default providers (Phase 00 uses mock providers)
DEFAULT_LLM_PROVIDER=mock
DEFAULT_MUSIC_PROVIDER=mock
DEFAULT_IMAGE_PROVIDER=mock
DEFAULT_TREND_PROVIDER=mock

# Resource limits (single active render for the target 16 GB laptop)
MAX_CONCURRENT_PRODUCTIONS=1
MAX_RENDER_WORKERS=1

# Rendering defaults
MASTER_VIDEO_WIDTH=1920
MASTER_VIDEO_HEIGHT=1080
MASTER_VIDEO_FPS=30
SHORT_VIDEO_WIDTH=1080
SHORT_VIDEO_HEIGHT=1920
SHORT_VIDEO_DURATION_SECONDS=45

# CORS origins (JSON array or comma-separated)
# CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Provider credentials — never commit real values. Only needed once real
# providers are configured (Phase 17+). Leave unset for mock mode.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
